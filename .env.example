# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fraudshield
MONGODB_DB_NAME=fraudshield

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay Configuration
RAZORPAY_KEY_ID=your-test-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-key

# JWT Auth Configuration
SECRET_KEY=any-long-random-string-for-jwt

# Admin Configuration
ADMIN_KEY=any-secret-string-for-admin-routes
